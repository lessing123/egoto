# ═══════════════════════════════════════
# Egoto — Variables d'environnement
# ═══════════════════════════════════════
# Copie ce fichier en .env et remplis les valeurs

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/egoto

# JWT
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars

# Server
PORT=3000
